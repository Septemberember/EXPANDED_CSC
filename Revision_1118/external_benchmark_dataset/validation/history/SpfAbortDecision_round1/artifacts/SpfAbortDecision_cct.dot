  node1 -> node2 [label="F", color="#c62828", style=dashed];
  node3 [label="(1) fired\nWP: fired", fillcolor="#f5f5f5", fontcolor="#333333"];
  node1 -> node3 [label="T", color="#2e7d32"];
  node4 [label="(1) altitude >= 120000\nWP: altitude >= 120000", fillcolor="#f5f5f5", fontcolor="#333333"];
  node3 -> node4 [label="F", color="#c62828", style=dashed];
  node5 [label="tc_2(altitude=0, fired=False)", shape=ellipse, fillcolor="#e8f5e9", fontcolor="#1b5e20"];
  node4 -> node5 [label="F", color="#c62828", style=dashed];
  node6 [label="✗ INFEASIBLE", shape=ellipse, fillcolor="#d6d6d6", fontcolor="#555555"];
  node4 -> node6 [label="T", color="#2e7d32"];
  node7 [label="✗ INFEASIBLE", shape=ellipse, fillcolor="#d6d6d6", fontcolor="#555555"];
  node3 -> node7 [label="T", color="#2e7d32"];
  node8 [label="(1) altitude <= 120000\nWP: altitude <= 120000", fillcolor="#f5f5f5", fontcolor="#333333"];
  node0 -> node8 [label="T", color="#2e7d32"];
  node9 [label="✗ INFEASIBLE", shape=ellipse, fillcolor="#d6d6d6", fontcolor="#555555"];
  node8 -> node9 [label="F", color="#c62828", style=dashed];
  node10 [label="(1) fired\nWP: fired", fillcolor="#f5f5f5", fontcolor="#333333"];
  node8 -> node10 [label="T", color="#2e7d32"];
  node11 [label="✗ INFEASIBLE", shape=ellipse, fillcolor="#d6d6d6", fontcolor="#555555"];
  node10 -> node11 [label="F", color="#c62828", style=dashed];
  node12 [label="(1) altitude >= 120000\nWP: altitude >= 120000", fillcolor="#f5f5f5", fontcolor="#333333"];
  node10 -> node12 [label="T", color="#2e7d32"];
  node13 [label="tc_8(altitude=0, fired=True)", shape=ellipse, fillcolor="#e8f5e9", fontcolor="#1b5e20"];
